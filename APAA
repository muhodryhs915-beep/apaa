        <script>
            
            let currentPage = 0;
            let sudahSelesai = false;

            const pages = document.querySelectorAll(".hal");
            const cover = document.getElementById("cover");
            const pagesContainer = document.getElementById("hal");

            const prevButton = document.querySelector(".prev");
            const nextButton = document.querySelector(".next");

            function openBook() {
                pagesContainer.style.display = "flex";
                showPage(currentPage);

                cover.classList.add("buka");

                setTimeout(() => {
                    cover.style.display = "none";
                }, 200);
            }

            function showPage(index, arah = "maju") {

                pages.forEach(page => {
                    page.classList.remove(
                        "active",
                        "flip-maju",
                        "flip-mundur"
                    );
                });

                const halaman = pages[index];

                halaman.classList.add("active");

                if (arah === "maju") {
                    halaman.classList.add("flip-maju");
                } else {
                    halaman.classList.add("flip-mundur");
                }

                if (currentPage === 0) {
                    prevButton.textContent = "← sampul";
                } else {
                    prevButton.textContent = "← balik";
                }

                if (currentPage === pages.length - 1) {
                    nextButton.textContent = "selesai ✓";
                } else {
                    nextButton.textContent = "lanjut →";
                }
            }


            function kembaliCover() {

                pagesContainer.style.display = "none";
                cover.style.display = "flex";
                setTimeout(() => {
                    cover.classList.remove("buka");
                }, 50);
                currentPage = 0;

            }

           let jumlahKlikSelesai = 0;

            function berikutnya() {
                if (currentPage < pages.length - 1) {
                    currentPage++;
                    showPage(currentPage, "maju");
                } else {
                    if (jumlahKlikSelesai < 5) {
                        jumlahKlikSelesai++;

                        buatHujanConfetti();

                        if (jumlahKlikSelesai < 5) {
                            nextButton.textContent =
                                `SELESAI (${jumlahKlikSelesai}/5) 🎉`;
                        } else {
                            nextButton.textContent = "UDAH 5 KALI WOI 😭";
                        }
                    } else {
                        nextButton.textContent = "SELESAI ✓";
                    }
                }
            }

            function sebelumnya() {

                if (currentPage === 0) {
                    kembaliCover();
                } else {
                    currentPage--;
                    showPage(currentPage, "mundur");
                }

            }

            function beruangRahasia(event) {
                event.stopPropagation();
                cover.style.display = "none";
                document.getElementById("rahasia").style.display = "flex";
            }

            function tutupRahasia() {
                document.getElementById("rahasia").style.display = "none";
                cover.style.display = "flex";
            }

            function bungarahasia(event) {
                event.stopPropagation();
                document.getElementById("munculbunga").style.display = "flex";
            }

            function balikrahasia() {
                document.getElementById("munculbunga").style.display = "none";
                document.getElementById("tomri").style.display = "none";
                document.getElementById("surat").style.display = "none";
            }

            function muor() {
                document.getElementById("gua").style.display = "block";
                if (document.getElementById("gua").style.display === "block") {
                    setTimeout(function() {
                        document.getElementById("gua").style.display = "none";
                    }, 3000);
                }
            }

            function tomra(event) {
                document.getElementById("tomri").style.display = "flex";
            }

            function bukasurat() {
                document.getElementById("surat").style.display = "flex";
            }

            const daftarStiker = [
                "🐻",
                "🌷",
                "🎓"
            ];

            function buatConfetti() {

                const stiker = document.createElement("div");

                stiker.classList.add("confetti");

                const randomStiker =
                    daftarStiker[
                        Math.floor(Math.random() * daftarStiker.length)
                    ];

                stiker.textContent = randomStiker;

                stiker.style.left =
                    Math.random() * 100 + "vw";

                stiker.style.animationDuration =
                    Math.random() * 3 + 3 + "s";


                stiker.onclick = function() {

                    stiker.textContent = "💥";

                    stiker.classList.add("meledak");

                    setTimeout(function() {

                        stiker.remove();

                    }, 300);

                };


                document
                    .getElementById("confetti-container")
                    .appendChild(stiker);


                setTimeout(function() {

                    stiker.remove();

                }, 7000);

            }

            function buatHujanConfetti() {

                let jumlah = 0;

                const hujan = setInterval(function() {

                    if (jumlah === 16) {

                        buatStikerRahasia();

                    } else {

                        buatConfetti();

                    }

                    jumlah++;

                    if (jumlah >= 30) {

                        clearInterval(hujan);

                    }

                }, 200);

            }

            function buatStikerRahasia() {
                const stiker = document.createElement("div");
                stiker.classList.add("confetti");
                stiker.textContent = "👑";
                stiker.style.left = Math.random() * 100 + "vw";
                stiker.style.animationDuration = "6s";
                stiker.onclick = function() {
                    bukaEasterEgg();
                    stiker.remove();

                };

                document
                    .getElementById("confetti-container")
                    .appendChild(stiker);

            }

            function bukaEasterEgg() {

                document.getElementById("easterEgg")
                    .style.display = "flex";

            }

            function tutupEgg() {

                document.getElementById("easterEgg")
                    .style.display = "none";

            }
        </script>
    </body>
</html>
